# ── App ───────────────────────────────────────────────────────────────────────
APP_NAME="AI Video Editor"
DEBUG=false
SECRET_KEY=your-secret-key-change-in-production

# ── Database (PostgreSQL) ─────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/aivideo

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
REDIS_BROKER_URL=redis://localhost:6379/1
REDIS_RESULT_BACKEND=redis://localhost:6379/2

# ── S3 / MinIO (use MinIO for local dev) ─────────────────────────────────────
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1
S3_BUCKET_VIDEOS=aivideo-inputs
S3_BUCKET_OUTPUTS=aivideo-outputs
S3_BUCKET_ASSETS=aivideo-assets

# ── Anthropic ─────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── AI provider mode (backend/ai/registry.py) ────────────────────────────────
# placeholder = no model/API calls, honest labeled output (default, works with
#               zero setup — this is what LOCAL_MODE runs with today).
# local       = requires implementing backend/ai/providers.py's Local* classes
#               with an actual local model.
# cloud       = requires implementing the Cloud* classes (e.g. using
#               ANTHROPIC_API_KEY above) plus setting AI_MODE=cloud.
AI_MODE=placeholder
AI_DEVICE=cuda

# ── FFmpeg ────────────────────────────────────────────────────────────────────
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# ── AI Models ────────────────────────────────────────────────────────────────
WHISPERX_MODEL_SIZE=large-v3
WHISPERX_DEVICE=cuda
WHISPERX_COMPUTE_TYPE=float16

# ── Qdrant ───────────────────────────────────────────────────────────────────
QDRANT_URL=http://localhost:6333
